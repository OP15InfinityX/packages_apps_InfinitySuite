<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/ambient_text_category_title">

    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="doze_enabled"
        android:title="@string/doze_title"
        android:summary="@string/doze_summary" />

    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="doze_always_on"
        android:title="@string/doze_always_on_title"
        android:summary="@string/doze_always_on_summary" />

    <Preference
        android:key="always_on_display_schedule"
        android:title="@string/always_on_display_schedule_title"
        android:summary="@string/always_on_display_schedule_summary"
        android:fragment="com.infinity.suite.fragments.doze.AODSchedule"
        android:dependency="doze_always_on" />

    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="doze_on_charge"
        android:title="@string/doze_on_charge_title"
        android:summary="@string/doze_on_charge_summary" />

    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="doze_peek"
        android:title="@string/doze_peek_title"
        android:summary="@string/doze_peek_summary"
        android:defaultValue="false" />

    <com.infinity.support.preferences.SecureSettingListPreference
        android:key="doze_peek_duration"
        android:title="@string/doze_peek_duration_title"
        android:entries="@array/doze_peek_duration_entries"
        android:entryValues="@array/doze_peek_duration_values"
        android:defaultValue="5"
        android:dependency="doze_peek"
        android:summary="%s" />

    <PreferenceCategory
        android:key="aod_brightness_category"
        android:title="@string/aod_brightness_category_title">

        <com.infinity.support.preferences.SystemSettingSeekBarPreference
            android:key="aod_low_brightness"
            android:title="@string/aod_low_brightness_title"
            android:summary="@string/aod_low_brightness_summary"
            android:defaultValue="8"
            android:max="255"
            settings:min="1"
            settings:interval="1" />

        <com.infinity.support.preferences.SystemSettingSeekBarPreference
            android:key="aod_high_brightness"
            android:title="@string/aod_high_brightness_title"
            android:summary="@string/aod_high_brightness_summary"
            android:defaultValue="60"
            android:max="255"
            settings:min="1"
            settings:interval="1" />

        <com.infinity.support.preferences.SystemSettingSwitchPreference
            android:key="aod_pickup_brightness_boost"
            android:title="@string/aod_pickup_brightness_boost_title"
            android:summary="@string/aod_pickup_brightness_boost_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <lineageos.preference.RemotePreference
        android:key="doze_device_settings"
        android:title="@string/doze_additional_settings_title"
        android:summary="@string/doze_additional_settings_summary">
        <intent
            android:action="org.lineageos.settings.device.DOZE_SETTINGS" />
    </lineageos.preference.RemotePreference>

    <com.infinity.support.preferences.SystemSettingSwitchPreference
        android:key="custom_aod_image_enabled"
        android:title="@string/lockscreen_custom_image_enabled_title"
        android:summary="@string/lockscreen_custom_image_summary"
        android:defaultValue="false" />

    <Preference
        android:key="lockscreen_custom_image"
        android:title="@string/lockscreen_custom_image_title"
        android:summary="@string/lockscreen_custom_image_pick_summary"
        android:dependency="custom_aod_image_enabled" />

    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="pulse_on_new_tracks"
        android:title="@string/pulse_on_new_tracks_title"
        android:summary="@string/pulse_on_new_tracks_summary" />

    <Preference
        android:key="edge_light_settings"
        android:title="@string/edge_light_title"
        android:summary="@string/edge_light_summary"
        android:fragment="com.infinity.suite.fragments.doze.EdgeLightSettings" />

</PreferenceScreen>
