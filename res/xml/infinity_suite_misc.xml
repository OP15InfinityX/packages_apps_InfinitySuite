<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/misc_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
        android:title="@string/general_category">

    <Preference
            android:key="spoofing"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_title_summary"
            android:fragment="com.infinity.suite.fragments.Spoof" />

    <Preference
    android:key="display_cutout_force_fullscreen_settings"
    android:title="@string/display_cutout_force_fullscreen_title"
    android:summary="@string/display_cutout_force_fullscreen_summary">

    <intent
        android:action="android.intent.action.MAIN"
        android:targetPackage="org.lineageos.lineageparts"
        android:targetClass="org.lineageos.lineageparts.PartsActivity">

        <extra
            android:name=":settings:show_fragment"
            android:value="org.lineageos.lineageparts.applications.LongScreenSettings" />
    </intent>

    </Preference>

    <Preference
        android:key="smart_pixels"
        android:title="@string/smart_pixels_title" 
        android:summary="@string/smart_pixels_summary" 
        android:fragment="com.infinity.suite.fragments.SmartPixels" />

   	 <Preference
             android:key="hide_developer_status_settings"
             android:title="@string/hide_developer_status_title"
             android:summary="@string/hide_developer_status_summary"
             android:fragment="com.infinity.suite.fragments.HideDeveloperStatusSettings"
             settings:controller="com.infinity.suite.fragments.HideDeveloperStatusPreferenceController" /> 
    <!-- Sensor block per package -->
    <Preference
        android:key="sensor_block_settings"
        android:title="@string/sensor_block_title"
        android:summary="@string/sensor_block_summary"
        android:fragment="com.infinity.suite.fragments.SensorBlock"/>

    <!-- Adaptive Playback -->
    <Preference
        android:key="adaptive_playback_settings"
        android:title="@string/adaptive_playback_title"
        android:summary="@string/adaptive_playback_summary"
        android:fragment="com.infinity.suite.fragments.AdaptivePlayback" />

        <!-- Ignore window secure flags -->
        <com.infinity.support.preferences.GlobalSettingSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/miscellaneous_ignore_window_secure_title"
            android:summary="@string/miscellaneous_ignore_window_secure_summary"
            android:defaultValue="true" />

        <com.infinity.support.preferences.SystemSettingSwitchPreference
            android:key="hide_screen_capture_status"
            android:title="@string/hide_screen_capture_status_title"
            android:summary="@string/hide_screen_capture_status_summary"
            android:defaultValue="true"/>

        <!-- No storage restrict -->
        <com.infinity.support.preferences.GlobalSettingSwitchPreference
            android:key="no_storage_restrict"
            android:title="@string/no_storage_restrict_title"
            android:summary="@string/no_storage_restrict_summary"
            android:defaultValue="false" />

        <!-- Encryption -->
        <com.infinity.support.preferences.GlobalSettingSwitchPreference
            android:key="spoofing_storage_encryption"
            android:title="@string/spoofing_storage_encryption_title"
            android:summary="@string/spoofing_storage_encryption_summary"
            android:defaultValue="false" />

    <com.infinity.support.preferences.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:title="@string/app_downgrade_title"
        android:summary="@string/app_downgrade_summary"
        android:defaultValue="false"/>

        <!-- Unlimit screenrecord -->
        <com.infinity.support.preferences.SystemSettingSwitchPreference
            android:key="unlimit_screenrecord"
            android:title="@string/miscellaneous_unlimit_screenrecord_title"
            android:summary="@string/miscellaneous_unlimit_screenrecord_summary"
            android:defaultValue="false" />

    <!-- Show clipboard overlay -->
    <com.infinity.support.preferences.SecureSettingSwitchPreference
        android:key="show_clipboard_overlay"
        android:title="@string/show_clipboard_overlay_title"
        android:summary="@string/show_clipboard_overlay_summary"
        android:defaultValue="true"/>
    
    <!-- Flash SMS -->
    <com.infinity.support.preferences.SystemSettingSwitchPreference
            android:key="disable_flash_sms"
            android:title="@string/disable_flash_sms_title"
            android:summary="@string/disable_flash_sms_summary"
            android:defaultValue="false"/>

    <!-- Block PairIP license activity -->
        <com.infinity.support.preferences.SystemPropertySwitchPreference
            android:key="persist.sys.pairip.activity.block"
            android:title="@string/miscellaneous_pairip_activity_block_title"
            android:summary="@string/miscellaneous_pairip_activity_block_summary"
            android:defaultValue="false" /> 

    <!-- Pocket Judge -->
    <com.infinity.support.preferences.SystemSettingSwitchPreference
        android:key="pocket_judge"
        android:title="@string/pocket_judge_title"
        android:summary="@string/pocket_judge_summary"
        android:defaultValue="false" />

    </PreferenceCategory>
</PreferenceScreen>
